# GAME-MANIA — root environment template
# Copy to .env and fill in values. Never commit real secrets.

# ─── General ───────────────────────────────────────────
NODE_ENV=development
APP_NAME=GAME-MANIA
CURRENCY=GBP
LOCALE=en-GB
TZ=Europe/London

# ─── Public URLs ────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── Database (Docker Compose) ──────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gamemania
POSTGRES_PASSWORD=gamemania_dev_change_me
POSTGRES_DB=gamemania
DATABASE_URL=postgresql://gamemania:gamemania_dev_change_me@localhost:5432/gamemania?schema=public

# ─── Redis (optional cache / rate-limit store) ──────────
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars!!
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ─── Stripe ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── PayPal ─────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ─── Cloudinary ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Resend (email) ─────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=GAME-MANIA <noreply@gamemania.com>

# ─── Shipping defaults (editable in Admin) ──────────────
SHIPPING_FREE_THRESHOLD_PENCE=6000
SHIPPING_FLAT_RATE_PENCE=395

# ─── Analytics / SEO ────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Cloudflare (production) ────────────────────────────
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ─── Cookie / CORS ──────────────────────────────────────
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
