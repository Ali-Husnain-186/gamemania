NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Local direct-to-API (optional; skip Nginx):
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Production behind Nginx (preferred — same origin):
# NEXT_PUBLIC_API_URL=/api/v1
# NEXT_PUBLIC_SITE_URL=http://YOUR_IP:8080
# Staff admin UI: /admin
