# Backend environment — copy to .env
# Requires local PostgreSQL (no Docker). API listens on port 5000.

NODE_ENV=development
PORT=5000
APP_NAME=GAME-MANIA API

DATABASE_URL=postgresql://gamemania:gamemania_dev_change_me@localhost:5432/gamemania?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars!!
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000
# Single-site: admin lives at FRONTEND_URL/admin (local + production).
ADMIN_URL=http://localhost:3000/admin
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# --- Production (Hostinger single-site) example ---
# FRONTEND_URL=https://YOUR_DOMAIN
# ADMIN_URL=https://YOUR_DOMAIN/admin
# CORS_ORIGINS=https://YOUR_DOMAIN
# COOKIE_DOMAIN=YOUR_DOMAIN
# GOOGLE_CALLBACK_URL=https://YOUR_DOMAIN/api/v1/auth/google/callback
# NEXT_PUBLIC_API_URL on frontend = https://YOUR_DOMAIN/api/v1


# Stripe (Dashboard → Developers → API keys)
# Required for any paid checkout. Without STRIPE_SECRET_KEY, paid orders are rejected
# (no fake "Order confirmed"). Use test keys first: sk_test_...
STRIPE_SECRET_KEY=
# Local webhook (recommended while developing):
#   stripe listen --forward-to localhost:5000/api/v1/payments/stripe/webhook
# Paste the whsec_... signing secret below, then restart the API.
# Production: Dashboard → Webhooks → https://YOUR_DOMAIN/api/v1/payments/stripe/webhook
# Events: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Gmail SMTP — no custom domain required) ---
# 1) Use a normal Gmail address
# 2) Google Account → Security → 2-Step Verification ON
# 3) Security → App passwords → generate for "Mail"
# 4) Paste the 16-character app password into SMTP_PASS (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must match the Gmail you use in SMTP_USER:
EMAIL_FROM=GAME MANIA <your.gmail@gmail.com>

# Optional later (when you have a domain): Resend
RESEND_API_KEY=

SHIPPING_FREE_THRESHOLD_PENCE=6000
SHIPPING_FLAT_RATE_PENCE=395
